version: '3.8'
services:
  nginx:
    image: nginx:latest
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./frontend-apps/app1/build:/usr/share/nginx/html/app1:ro  # Serve the frontend app
    depends_on:
      - api-gateway
    networks:
      - my-network

  api-gateway:
    build: ./api-gateway
    ports:
      - "8000:8000"
    networks:
      - my-network

  auth-service:
    build: ./auth-service
    ports:
      - "8001:8001"
    networks:
      - my-network

  reservation-service:
    build: ./reservation-service
    ports:
      - "8002:8002"
    networks:
      - my-network

networks:
  my-network:
    driver: bridge
